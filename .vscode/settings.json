{
  // Turn off occurrence highlighting (prevents pale-yellow highlights when the cursor is on a symbol)
  "editor.occurrencesHighlight": "off",
  // Disable selection highlights across the document
  "editor.selectionHighlight": false,
  // Prevent Find from seeding the search string from selection
  "editor.find.seedSearchStringFromSelection": "never",
  // Disable active-line highlight entirely
  "editor.renderLineHighlight": "none",
  // If GitLens is installed, disable current-line blame overlay
  "gitlens.currentLine.enabled": false,
  // Disable GitLens extension features in this workspace
  "gitlens.enabled": false
  ,
  // Reduce other editor noise
  "editor.codeLens": false,
  "editor.inlineSuggest.enabled": false,
  "editor.hover.enabled": false,
  "editor.minimap.enabled": false,
  "editor.inlayHints.enabled": "off",
  // Disable parameter hints/signature help
  "editor.parameterHints.enabled": false
  ,
  // Force various highlight backgrounds to transparent to eliminate pale overlays
  "workbench.colorCustomizations": {
    "editor.wordHighlightBackground": "#00000000",
    "editor.wordHighlightStrongBackground": "#00000000",
    "editor.wordHighlightBorder": "#00000000",
    "editor.selectionBackground": "#00000000",
    "editor.selectionForeground": "#00000000",
    "editor.selectionHighlightBackground": "#00000000",
    "editor.findMatchBackground": "#00000000",
    "editor.findMatchBorder": "#00000000",
    "editor.findMatchHighlightBackground": "#00000000",
    "editor.findMatchHighlightBorder": "#00000000",
    "editor.rangeHighlightBackground": "#00000000",
    "editor.rangeHighlightBorder": "#00000000",
    "editor.findRangeHighlightBackground": "#00000000",
    "editor.hoverHighlightBackground": "#00000000",
    "editor.lineHighlightBackground": "#00000000",
    "editor.lineHighlightBorder": "#00000000",
    "editorBracketMatch.background": "#00000000",
    "editorBracketMatch.border": "#00000000",
    "editorOverviewRuler.modifiedBackground": "#00000000",
    "editorOverviewRuler.addedBackground": "#00000000",
    "editorOverviewRuler.deletedBackground": "#00000000",
    "gitlens.gutterBackgroundColor": "#00000000"
  }
}
